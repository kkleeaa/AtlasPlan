      "birthday": "14/03/2018",
      "animal": "bear",
      "evaluationType": "STANDARD",
      "teacherId": "teacher-demo",
      "parentId": "parent-demo",
      "learningStyle": "Përfiton nga mbështetja vizuale, frazat e shkurtra dhe rutinat e qarta.",
      "age": 8,
      "diagnosis": "Profil mësimor",
      "communication": "Përdor fraza të shkurtra, zgjedhje me figura dhe përgjigje po/jo. Përfiton nga koha e pritjes dhe mbështetjet vizuale.",
      "fineMotorGoals": [
        "Të përmirësojë kapjen me gishta për mjetet e klasës",
        "Të presë përgjatë vijave të lakuara me gërshërë të përshtatura",
        "Të shkruajë emrin me formim të qëndrueshëm të shkronjave"
      ],
      "grossMotorGoals": [
        "Të ndjekë një rutinë lëvizjeje me tre hapa",
        "Të rrisë ekuilibrin gjatë kalimeve në këndin e lojës"
      ],
      "speechGoals": [
        "Të përdorë kërkesë me pesë fjalë me mbështetje vizuale",
        "T'u përgjigjet pyetjeve kush/çfarë/ku pas një tregimi"
      ],
      "sensoryNeeds": [
        "Ulja e zhurmës gjatë mbledhjeve",
        "Pushime lëvizjeje çdo 45 minuta",
        "Qasje në kënd të qetë pas ndryshimeve të papritura"
      ],
      "behaviorTriggers": [
        "Kalime me zhurmë",
        "Ndryshime të papritura të orarit",
        "Detyra të gjata shkrimi pa pushime"
      ],
      "allergies": [
        "Nuk janë shënuar alergji"
      ],
      "reinforcers": [
        "Zgjedhje ngjitëseje",
        "Kohë për vizatim",
        "Puzzle pesëminutëshe",
        "Zgjedhje e rolit ndihmës në klasë"
      ],
      "immediateObjectives": [
        "Të përdorë tabelën së pari/pastaj gjatë kohës së shkrimit",
        "Të kërkojë pushim duke përdorur kartë me figurë",
        "Të përfundojë sekuencën e larjes së duarve me dy udhëzime ose më pak"
      ],
      "longTermObjectives": [
        "Të përdorë në mënyrë të pavarur orarin vizual gjatë ditës shkollore",
        "Të komunikojë nevojat me të folur, AAC ose shkëmbim figurash",
        "Të kryejë rutinat e kujdesit personal me pak udhëzim nga i rrituri"
      ],
      "strengths": [
        "Kujtesë e fortë vizuale",
        "I pëlqen të ndihmojë shokët",
        "Përgjigjet mirë ndaj rutinave të parashikueshme",
        "Ka kureshtje për shkencën dhe artin"
      ],
      "challenges": [
        "Vështirësi në mjedise me zhurmë",
        "Ka nevojë për mbështetje për të nisur lojën me shokët",
        "Qëndrueshmëria në shkrim është e kufizuar"
      ],
      "notes": [],
      "completedGoals": [
        "Përgjigjet ndaj gjuhës së pari/pastaj me një kujtesë"
      ],
